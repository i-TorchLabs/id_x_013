# =============================================================================
# id_x_013 一键部署环境变量示例
#
# 使用方法：
#   cd x_models/id_x_013/ops
#   cp .env.example .env
#   # 按需修改下方值（务必改 POSTGRES_PASSWORD）
#   podman compose up -d
# =============================================================================

# ---------------- PostgreSQL ----------------
POSTGRES_DB=id_x_013
POSTGRES_USER=postgres
# 请改成强密码（数据库与 service 容器共享此值）
POSTGRES_PASSWORD=change-me

# ---------------- 容器内项目根路径（关键） ----------------
# base_config.toml 的 [BASE].PROJECT_PATH 用 ${PROJECT_PATH} 占位符。
# 容器内如果不显式覆盖，会回退到 TOML 中的字面值
# /home/master/Desktop/codeSpace/id_x_000（宿主机路径），导致文件被写到
# 容器内并不存在的同名字面目里。这里强制注入容器内真实工作目录。
PROJECT_PATH=/app/id_x_000

# ---------------- 端口绑定 ----------------
# haproxy 监听 Pod 内 8080，固定映射到宿主机 8085（在 podman-compose.yml 中）
# 仅作文档说明，compose 不会读取此变量
# HAPROXY_HOST_PORT=8085
