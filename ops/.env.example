# =============================================================================
# id_x_013 一键部署环境变量示例
#
# 使用方法：
#   cd x_models/id_x_013/ops
#   cp .env.example .env
#   # 按需修改下方值（务必改 POSTGRES_PASSWORD）
#   ./up.sh                        # 方式一：同 Pod 四容器（共享网络命名空间）
#   # 或
#   podman-compose up -d --build   # 方式二：compose bridge 网络（见 compose.yaml）
# =============================================================================

# ---------------- PostgreSQL ----------------
POSTGRES_DB=id_x_013
POSTGRES_USER=postgres
# 请改成强密码（数据库与 service 容器共享此值）
POSTGRES_PASSWORD=change-me

# ---------------- 容器内项目根路径（关键） ----------------
# 容器内如果不显式注入，内核会回退到 config/base_config.toml 中
# [BASE].PROJECT_PATH 的字面值（宿主机路径），导致日志等文件被写到
# 容器内并不存在的同名目录里。这里强制注入容器内真实工作目录。
PROJECT_PATH=/app/i-Core

# ---------------- 端口绑定 ----------------
# haproxy 监听 Pod/容器内 8080，发布到宿主机的端口：
#   up.sh 固定为 8013（见 up.sh 中 podman pod create -p 8013:8080）
#   compose 模式可通过 POD_PORT 覆盖（默认 8013）
POD_PORT=8013
# compose 模式额外将 db 5432 发布到宿主机，供外部工具直连（默认 54323）
DB_HOST_PORT=54323
