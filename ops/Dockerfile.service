# id_x_013 后端服务镜像（Litestar + Granian，引擎层 id_x_000 作为 ASGI 宿主）。
#
# 构建上下文必须是 id_x_000 仓库根，这样引擎层（main.py / src / utils / config）
# 与业务插件（x_models/id_x_013）能被一并复制进镜像，保持原有相对 import
# 与 config 解析（utils/config_parse_util.py 按 __file__ 定位 config/）。
#
#   podman build -t id_x_013-service -f x_models/id_x_013/ops/Dockerfile.service .

FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TZ=Asia/Shanghai

WORKDIR /app/id_x_000

# 系统依赖：
#   build-essential  编译 psycopg2 wheel
#   libpq-dev        psycopg2 编译头
#   curl             容器健康检查
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        curl \
    && rm -rf /var/lib/apt/lists/*

# 先装依赖（利用 docker layer cache：requirements 变化才重装）
COPY x_models/id_x_013/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# 按需复制 id_x_013 运行所需文件，不带 id_x_002_esg / id_x_028 等其他插件目录。
#   main.py / src / utils / config    引擎层与配置
#   x_models/_contracts               插件契约公共包（id_x_013 的 x_plugin.py 依赖）
#   x_models/id_x_013                 业务插件本体
COPY main.py /app/id_x_000/main.py
COPY src /app/id_x_000/src
COPY utils /app/id_x_000/utils
COPY config /app/id_x_000/config
COPY x_models/_contracts /app/id_x_000/x_models/_contracts
COPY x_models/id_x_013 /app/id_x_000/x_models/id_x_013

# utils/database_cli_util.py 中硬编码 `from x_models.id_x_002_c2.src.models.x_models import Base`
# （引擎层的遗留耦合），因此镜像必须包含 id_x_002_c2 源码，否则 import 失败导致启动崩溃。
# 但 base_config.toml 的 [EXTEND].MODELS 只注册 id_x_013，id_x_002_c2 不会被加载为插件，
# 不会在路由/建表流程中产生副作用。
COPY x_models/id_x_002_c2 /app/id_x_000/x_models/id_x_002_c2

# 运行时目录（logs 由 compose 挂卷持久化）
RUN mkdir -p /app/id_x_000/logs

EXPOSE 7000

# Granian 作为 ASGI 服务器跑引擎层 main:obj（Litestar 实例）。
# LISTEN_PORT 在 base_config.toml 中为 7000。
CMD ["python", "main.py"]
